{
  "name": "moran-family-board-card",
  "version": "0.25.1-moran.2",
  "description": "Configurable family operations board for Home Assistant",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/emilianomoran/moran-family-board-card#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emilianomoran/moran-family-board-card.git"
  },
  "bugs": {
    "url": "https://github.com/emilianomoran/moran-family-board-card/issues"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:harness": "node dev/harness-check.mjs",
    "preview:live": "node dev/live-preview.mjs",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "prettier": "^3.2.5",
    "rollup": "^4.9.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
